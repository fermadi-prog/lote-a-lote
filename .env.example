# Copiá este archivo a .env para desarrollo local (nunca subas el .env real a git)

# Cadena de conexión a Postgres. En local, con el usuario/base que creaste vos:
DATABASE_URL=postgres://lotealote:devpassword@localhost:5432/lotealote

# Clave para firmar las cookies de sesión — cualquier texto largo y aleatorio.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio

# Usuario administrador que se crea automáticamente al arrancar el servidor
# (si ya existe un usuario con ese email, simplemente se le confirma is_admin=true).
ADMIN_EMAIL=admin@fermadi.com.py
ADMIN_PASSWORD=cambiame
ADMIN_NAME=Administrador

PORT=3000
